POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry

# How long to keep telemetry rows before the consumer purges them (Go duration syntax).
# Active entries are refreshed on every upsert so only stale/disconnected data expires.
DATA_TTL=5m

# SAML / Azure AD authentication (optional)
# Set SAML_ENABLED=true and fill in the values below to enable.
SAML_ENABLED=false
# Azure AD federation metadata URL — replace <TENANT_ID> and <APP_ID>
SAML_IDP_METADATA_URL=https://login.microsoftonline.com/<TENANT_ID>/federationmetadata/2007-06/federationmetadata.xml?appid=<APP_ID>
SAML_SP_ROOT_URL=https://example.webapp.com
# Paths to the SP signing certificate and private key (PEM format)
SAML_SP_CERT_FILE=./certs/saml/sp.crt
SAML_SP_KEY_FILE=./certs/saml/sp.key

# Set to true to enable the raw DB explorer page (/dbview) and its API (/api/db-inspect).
# Intended for troubleshooting only — leave disabled in normal operation.
DBVIEW_ENABLED=false
